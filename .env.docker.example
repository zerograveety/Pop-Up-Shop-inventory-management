# Copy to .env when using the Docker Compose database (docker compose up -d):
#   cp .env.docker.example .env
#
# These match the postgres service defined in docker-compose.yml.

# Server
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (matches docker-compose.yml)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=InventoryManagement
DB_PASSWORD=postgres
DB_PORT=5432

# JWT - generate a strong secret for production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
